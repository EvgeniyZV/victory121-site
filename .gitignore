# OS / Editor files
.DS_Store
Thumbs.db
desktop.ini
*.log

# Python cache
__pycache__/
*.py[cod]

# Graphify temporary build sidecars (machine-specific paths)
# Keep graph.json, GRAPH_REPORT.md, graph.html, GRAPH_TREE.html, wiki/, manifest.json, cost.json, cache/ tracked!
graphify-out/.graphify_*
graphify-out/.rebuild.lock

# Secrets and hosting credentials (NEVER commit to Git)
.env
.env.*
*.pem
*.key
deploy-config.json



# Graphify HTML visualisations: local only (nginx serves .html directly, .htaccess cannot hide them on the live site)
graphify-out/graph.html
graphify-out/GRAPH_TREE.html
